#keep seed constant
-constant_seed 1

#ignore unrecognized residues to help mitigate crashes
-ignore_unrecognized_res

#handle ligand repeats if using multiple anchor residues, will otherwise crash without this flag
-in::file::override_database_params true

#constrain coordinates
-constrain_relax_to_start_coords

#keep all placements; 0 means keep all, any other integer means keep up to that integer
-best_pdbs_to_keep 0

#mapped protein system
#-s /pi/summer.thyme-umw/rosetta_discovery_space/gpr151/gpr151_discovery_thymelab/structures/9W3L.pdb
-s /input/9W3L.pdb

#mapped motifs file

#/pi/summer.thyme-umw/2024_intern_lab_space/FINAL_motifs_list_filtered_2_3_2023.motifs
-motif_filename /input/FINAL_motifs_list_filtered_2_3_2023.motifs

#mapped test_params directory
#can use a dummy set of test params just so that we get a placement
-params_directory_path /input/test_params/

#rosetta-indexed anchor residue index/indices
-protein_discovery_locus 2

#fa_atr cutoff
-fa_atr_cutoff = -2

#fa_rep cutoff
-fa_rep_cutoff = 150

#ddg cutoff
-ddg_cutoff = -9

###################################################

#extra user args from: /pi/summer.thyme-umw/rosetta_discovery_space/pth2/shapedb_results/top_hits/lower/lower_res1_11_shifted/extra_args

#define the center of the binding pocket as integer coordinates. Coordinates should be relative to the PDB being inputted in the -s flag.
-binding_pocket_center_sf 169,201,153

#integer dimensions in angstroms to investigate +/- in the x,y,z directions from the center. I.e. a value of 5 will investigate 5 angstroms positive and negative of the coordinate in a given dimensions
#this forms a rectangular prism, more specifically a cube if all values are equal
-binding_pocket_dimensions_sf 5,5,5

#this should be set to zero for pocket derivation
-space_fill_cutoff_differential_score_sub 0.0

#These are typically debug arguments that are used to view the ProteinGrid of a system, and should be set to false in large discovery operations:
#output the ProteinGrid of a system to PDB format for visualization and representation of occupied space
-output_space_fill_matrix_pdbs true
#output the empty space of a system as explicit atoms, rather than leave empty. Useful for representing the cavity space of a binding pocket.
-use_empty_space_in_space_fill_pdb true
